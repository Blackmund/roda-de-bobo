# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Supabase Realtime Presence & Broadcast Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# MQTT Cloud Realtime Synchronization (Zero-Config fallback when Supabase is not configured)
# Default primary SSL WebSocket broker: wss://broker.emqx.io:8084/mqtt
VITE_MQTT_BROKER_URL="wss://broker.emqx.io:8084/mqtt"
# Comma-separated list of fallback MQTT WebSocket brokers in case the primary is unreachable
VITE_MQTT_FALLBACK_BROKERS="wss://broker.hivemq.com:8884/mqtt,wss://test.mosquitto.org:8081"
# Pub/Sub topic prefix (e.g. roda-de-bobo-v2/room/ROOMCODE)
VITE_MQTT_TOPIC_PREFIX="roda-de-bobo-v2/room"
# Optional MQTT authentication (leave empty for public brokers)
VITE_MQTT_USERNAME=""
VITE_MQTT_PASSWORD=""
